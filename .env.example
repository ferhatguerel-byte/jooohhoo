# E-Mail-Versand für das Angebotsformular (https://resend.com)
RESEND_API_KEY=re_...
FROM_EMAIL=anfrage@rundumwerk24.de
# Optional: abweichende Empfangsadresse für eingehende Anfragen
QUOTE_NOTIFY_EMAIL=

# Ohne RESEND_API_KEY werden Anfragen nur ins Server-Log geschrieben
# (kein Versand, kein Absturz) – praktisch zum lokalen Testen.
