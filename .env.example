# Datenbank (Postgres – z.B. Vercel Postgres / Neon)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Session-Verschlüsselung (langer, zufälliger String)
SESSION_SECRET=

# KI-Leistungsverzeichnis (Anthropic API)
# Key erstellen unter: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Stripe (Abo-Zahlungen der Unternehmer)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...
# Optional: ID einer eingeschränkten Stripe-Kundenportal-Konfiguration ohne
# Kündigungs-Option, für Nutzer im Jahrespaket während der Mindestlaufzeit.
STRIPE_PORTAL_CONFIGURATION_ID_LOCKED=

# E-Mail-Benachrichtigungen (optional, sonst nur Server-Log)
RESEND_API_KEY=re_...
FROM_EMAIL=benachrichtigungen@bauversus.de

# Öffentliche URL der App (für Stripe Redirects, E-Mail-Links)
NEXT_PUBLIC_APP_URL=https://www.bauversus.de

# Datei-Upload (Bilder/Dateien bei Aufträgen, Verifizierungsnachweise)
# Wird automatisch gesetzt, sobald im Vercel-Dashboard unter Storage ein
# Blob-Store erstellt und mit dem Projekt verbunden wird.
BLOB_READ_WRITE_TOKEN=

# E-Mail-Adresse, die Zugriff auf /dashboard/admin/verifizierungen hat
# (Freigabe der Nachweise von Unternehmern)
ADMIN_EMAIL=

# Error Tracking (Phase 4.4, optional – ohne diese Variablen bleibt das Tracking ein
# vollständiger No-op, kein Absturz, keine Netzwerkaufrufe). SENTRY_DSN für serverseitige
# Fehler (API-Routen, Cron, Webhooks), NEXT_PUBLIC_SENTRY_DSN zusätzlich für clientseitige
# Fehler (error.tsx/global-error.tsx) – Next.js exponiert nur NEXT_PUBLIC_*-Variablen an den
# Browser-Bundle, SENTRY_DSN allein reicht dafür nicht aus. In der Praxis derselbe DSN-Wert.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: überschreibt die an Sentry gemeldete Environment (Default: NODE_ENV).
SENTRY_ENVIRONMENT=
