# Datenbank (Postgres – z.B. Vercel Postgres / Neon)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Session-Verschlüsselung (langer, zufälliger String)
SESSION_SECRET=

# Stripe (Abo-Zahlungen der Auftraggeber)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...

# Öffentliche URL der App (für Stripe Redirects)
NEXT_PUBLIC_APP_URL=https://www.baupartner24.de
