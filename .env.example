# Datenbank (Postgres – z.B. Vercel Postgres / Neon)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Session-Verschlüsselung (langer, zufälliger String)
SESSION_SECRET=

# KI-Leistungsverzeichnis (Anthropic API)
# Key erstellen unter: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Stripe (Abo-Zahlungen der Auftraggeber)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...

# E-Mail-Benachrichtigungen (optional, sonst nur Server-Log)
RESEND_API_KEY=re_...
FROM_EMAIL=benachrichtigungen@bauversus.de

# Öffentliche URL der App (für Stripe Redirects, E-Mail-Links)
NEXT_PUBLIC_APP_URL=https://www.bauversus.de
